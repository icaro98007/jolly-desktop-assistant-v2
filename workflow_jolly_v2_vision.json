    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.output || '';\nraw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nlet parsed = { texto: raw, emocion: 'neutral' };\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    const obj = JSON.parse(match[0]);\n    if (obj.texto) parsed.texto = obj.texto;\n    if (obj.emocion) parsed.emocion = obj.emocion;\n  }\n} catch (e) {}\nreturn [{ json: parsed }];"
      },
